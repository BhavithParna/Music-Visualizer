<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.lyricroom.daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>apps/daemon/dist/index.js</string>
  </array>
  <key>WorkingDirectory</key><string>REPLACE_WITH_REPO_PATH</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/lyricroom.log</string>
  <key>StandardErrorPath</key><string>/tmp/lyricroom.err</string>
</dict>
</plist>
